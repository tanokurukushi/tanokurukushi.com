---
import '@/styles/index.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: 'article' | 'website';
  publishedTime?: Date;
  modifiedTime?: Date;
  articleTags?: string[];
}

const {
  title: titleProp,
  description,
  noindex,
  type = 'website',
  publishedTime,
  modifiedTime,
  articleTags,
} = Astro.props;

const siteName = 'TanokuRukushi';
const title = titleProp ? `${titleProp} - ${siteName}` : siteName;
const ogTitle = titleProp ?? siteName;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL('/og-image.png', Astro.site).href;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={ogTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    {
      type === 'article' && (
        <>
          {publishedTime && (
            <meta property="article:published_time" content={publishedTime.toISOString()} />
          )}
          {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime.toISOString()} />
          )}
          {articleTags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tanokurukushi" />
    <meta name="twitter:title" content={ogTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={siteName} />
  </head>
  <body>
    <slot />
  </body>
</html>
