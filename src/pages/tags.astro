---
import MainLayout from '@/layouts/MainLayout.astro';
import { getPublishedBlogEntries } from '@/lib/content';
import { formatDate } from '@/lib/format';
import Tag from '@/components/Tag.astro';

const posts = await getPublishedBlogEntries();
const allTagNames = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const tags = allTagNames.map((name) => ({
  name,
  posts: posts.filter((post) => post.data.tags.includes(name)),
}));
---

<MainLayout title="Tags" description="投稿に付けたタグの一覧です。">
  <h1 class="sr-only">Tags</h1>
  <p class="my-8 leading-loose">投稿に付けたタグの一覧です。</p>
  {
    tags.length > 0 ? (
      <ol class="my-12">
        {tags.map((tag) => (
          <li class="border-t border-border">
            <details id={tag.name} class="group *:px-1">
              <summary class="flex items-center justify-between gap-5 py-5 marker:hidden hover:bg-zinc-50/5">
                <Tag name={tag.name} />
                <span class="flex items-center gap-3 font-mono text-xs text-fg-muted">
                  <span>{tag.posts.length} posts</span>
                  {/* Material Symbols: Chevron Right */}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="20px"
                    viewBox="0 -960 960 960"
                    width="20px"
                    fill="currentColor"
                    aria-hidden="true"
                    class="transition-transform group-open:rotate-90"
                  >
                    <path d="M522-480 333-669l51-51 240 240-240 240-51-51 189-189Z" />
                  </svg>
                </span>
              </summary>
              <ol class="my-1 mb-12">
                {tag.posts.map(({ id, data }) => (
                  <li class="flex items-center gap-3 border-l border-border py-3 pl-4">
                    <div class="flex items-center gap-1.5 font-mono text-xs text-fg-muted">
                      <span
                        class="size-[0.5em] flex-none rounded-xs bg-accent"
                        aria-hidden="true"
                      />
                      <span class="sr-only">公開日</span>
                      <time datetime={data.createdAt.toISOString()}>
                        {formatDate(data.createdAt)}
                      </time>
                    </div>
                    <a href={`/blog/${id}`} class="text-sm font-bold">
                      {data.title}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </li>
        ))}
      </ol>
    ) : (
      <p>まだタグがありません。</p>
    )
  }
</MainLayout>
