---
import { render } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import Tag from '@/components/Tag.astro';
import { formatDate } from '@/lib/format';
import { getPublishedBlogEntries } from '@/lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedBlogEntries();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
---

<MainLayout title={data.title} description={data.description}>
  <article class="py-8">
    <div class="mb-10">
      <div class="mb-3 flex items-center gap-3 font-mono text-xs text-fg-muted">
        <span>
          公開日: <time datetime={data.createdAt.toISOString()}>{formatDate(data.createdAt)}</time>
        </span>
        {
          data.updatedAt && (
            <span>
              更新日:{' '}
              <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time>
            </span>
          )
        }
      </div>
      <h1 class="mb-5 text-3xl font-bold text-pretty">{data.title}</h1>
      <div class="flex flex-wrap items-center gap-2">
        <span class="sr-only">タグ</span>
        {data.tags.map((tag) => <Tag name={tag} />)}
      </div>
    </div>
    <div class="prose">
      <Content />
    </div>
    <footer class="mt-8">
      <a href="/">← 一覧に戻る</a>
    </footer>
  </article>
</MainLayout>
