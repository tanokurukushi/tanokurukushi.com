{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanokurukushi-com",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "routes": [
    {
      "pattern": "tanokurukushi.com",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
}
